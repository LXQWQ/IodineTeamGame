{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iteamgame",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
