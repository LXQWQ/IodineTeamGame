<script id="marked-math-protect">
// 给 marked 注册 inline + block 数学扩展，让 $...$ 和 $$...$$ 在 markdown 解析阶段
// 不被 _ 或 * 误识别为斜体/加粗（KaTeX auto-render 会在 marked 后再扫一次，所以原样输出即可）
(function(){
  if (!window.marked || !window.marked.use) return;
  // 转义到 HTML 输出（避免 < > & 破坏 DOM）
  function escHTML(s){
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }
  const blockMath = {
    name: 'blockMath', level: 'block',
    start(src){ const i = src.indexOf('$$'); return i < 0 ? undefined : i; },
    tokenizer(src){
      const m = /^\$\$([\s\S]+?)\$\$/.exec(src);
      if (m) return { type:'blockMath', raw:m[0], text:m[1] };
    },
    renderer(t){ return '<p>$$' + escHTML(t.text) + '$$</p>\n'; }
  };
  const inlineMath = {
    name: 'inlineMath', level: 'inline',
    start(src){ const i = src.indexOf('$'); return i < 0 ? undefined : i; },
    tokenizer(src){
      // 单 $ 包裹，内部不能有换行、不能有未配对的 $；最少 1 个非空字符
      const m = /^\$(?!\$)([^\s$][^$\n]*?)\$/.exec(src);
      if (m) return { type:'inlineMath', raw:m[0], text:m[1] };
    },
    renderer(t){ return '$' + escHTML(t.text) + '$'; }
  };
  try { window.marked.use({ extensions: [blockMath, inlineMath] }); }
  catch(e) { console.warn('[marked-math-protect] failed:', e); }
})();
</script>

