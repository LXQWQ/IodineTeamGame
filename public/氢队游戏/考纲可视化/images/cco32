<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>考纲可视化 · CChO 2024 · 仅国初真题</title>
<link rel="icon" type="image/png" sizes="32x32" href="assets/favicon-32.png">
<link rel="icon" type="image/png" sizes="64x64" href="assets/favicon-64.png">
<link rel="icon" type="image/x-icon" href="assets/favicon.ico">
<link rel="apple-touch-icon" sizes="192x192" href="assets/favicon-192.png">
<meta name="theme-color" content="#005CFF">
<style>
  :root{
    --bg:#0f1115; --panel:#161922; --panel2:#1d2230; --line:#2a3041;
    --text:#e6e9ef; --muted:#8a93a6;
    --brand:#005CFF; --brand2:#3b78ff; --brand-soft:#80a8ff;
    --accent:#80a8ff; --accent2:#ffb86b;
    --star:#ffcc55; --hover:#222838; --sel:#1a2c5c;
    --lv1:#5fd28a; --lv2:#80a8ff; --lv3:#ff8a8a;
    /* ===== 视觉第二阶段：卡片层级 ===== */
    --radius-card:10px;          /* 大卡片统一圆角（题卡/考点卡/频率卡） */
    --radius-sm:6px;             /* 小元件保留原 6px（输入/小卡） */
    --shadow-card:0 1px 2px rgba(0,0,0,.18), 0 0 0 1px rgba(255,255,255,.02) inset;
    --shadow-card-hover:0 4px 14px rgba(0,92,255,.18), 0 0 0 1px rgba(0,92,255,.25) inset;
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0;height:100%;background:var(--bg);color:var(--text);
    font-family:-apple-system,"PingFang SC","Microsoft YaHei",Segoe UI,Roboto,sans-serif;
    font-size:14px;line-height:1.6;
    /* ★ 禁掉整页滚动：所有滚动都在内部 .col 滚动容器里。
       html 不能滚，否则 focus checkbox 触发的程序化 scrollIntoView 会推动视角。 */
    overflow:hidden}
  /* ★ 把 body 钉成 fixed 全屏：让 html.scrollHeight 强制 = clientHeight。
     不这样做的话，#colM 内 6000+px 的题卡内容会被 Chromium 计入
     documentElement.scrollHeight（getBoundingClientRect 不感知祖先 overflow clip），
     接着勾 checkbox 触发的浏览器内置 scrollIntoView 会去滚 html，
     表现为"勾题后视角下推 + 露出大片黑色"。 */
  body{position:fixed;inset:0;display:flex;flex-direction:column}
  a{color:var(--accent);text-decoration:none}
  button{font-family:inherit}

  /* ===== 顶栏 ===== */
  .topbar{height:52px;flex-shrink:0;display:flex;align-items:center;gap:14px;padding:0 18px;
    border-bottom:1px solid var(--line);
    background:linear-gradient(180deg, #161c2c 0%, var(--panel) 100%);
    box-shadow:0 0 0 1px rgba(0,92,255,.08), 0 1px 0 rgba(0,92,255,.18);
    flex-wrap:nowrap;overflow:hidden;min-width:0;position:relative}
  .topbar::after{content:"";position:absolute;left:0;right:0;bottom:0;height:2px;
    background:linear-gradient(90deg, var(--brand) 0%, var(--brand2) 35%, transparent 100%);
    opacity:.85;pointer-events:none}
  .topbar .brand{display:flex;align-items:center;gap:10px;flex-shrink:0;text-decoration:none;color:inherit}
  .topbar .brand-logo{height:30px;width:auto;display:block;
    filter:drop-shadow(0 0 6px rgba(0,92,255,.35))}
  .topbar .brand-text{display:flex;flex-direction:column;line-height:1.05;gap:1px}
  .topbar .brand-name{font-size:13.5px;font-weight:700;letter-spacing:.4px;
    background:linear-gradient(90deg, #ffffff 0%, #c8d6ff 100%);
    -webkit-background-clip:text;background-clip:text;color:transparent}
  .topbar .divider{width:1px;height:22px;background:var(--line);flex-shrink:0}
  .topbar h1{font-size:14.5px;font-weight:600;margin:0;white-space:nowrap;flex-shrink:0;color:var(--text)}
  .topbar .sub{font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
  .topbar .ver{font-size:11px;color:var(--muted);opacity:.7;
    font-family:Menlo,Consolas,monospace;letter-spacing:.3px;
    padding:2px 8px;border:1px solid var(--line);border-radius:4px;
    margin-left:4px;white-space:nowrap;flex-shrink:0;background:rgba(0,92,255,.04)}
  .topbar .ver:hover{opacity:1;color:var(--text);border-color:var(--brand2)}
  .topbar .guide-link{font-size:12px;color:var(--muted);
    padding:4px 10px;border:1px solid var(--line);border-radius:6px;
    text-decoration:none;white-space:nowrap;flex-shrink:0;
    background:rgba(0,92,255,.04);transition:all .15s;
    display:inline-flex;align-items:center;gap:4px}
  .topbar .guide-link:hover{color:var(--text);border-color:var(--brand2);
    background:rgba(0,92,255,.12)}
  .topbar .spacer{flex:1}
  .topbar .stat{font-size:12px;color:var(--muted);white-space:nowrap;flex-shrink:0}
  .topbar .stat b{color:var(--text)}
  /* 手机端顶栏：缩字号、减间距、隐藏次要信息，避免叠行 */
  @media(max-width:640px){
    .topbar{gap:8px;padding:0 10px;height:48px}
    .topbar .brand-logo{height:24px}
    .topbar .brand-text{display:none}
    .topbar h1{font-size:13.5px}
    .topbar .divider{display:none}
    .topbar .sub{display:none}
    .topbar .stat{display:none}
    .topbar .ver{font-size:10px;padding:1px 6px;margin-left:2px;letter-spacing:0}
    .topbar .guide-link{font-size:11px;padding:3px 8px}
    .topbar .guide-link span{display:none}
  }
  @media(max-width:380px){
    .topbar .ver{display:none}
    .topbar .guide-link{padding:3px 6px}
  }

  /* ===== 三栏 ===== */
  .layout{display:grid;grid-template-columns:280px 1fr 260px;
    flex:1; min-height:0; overflow:hidden}
  .col{overflow-y:auto;overflow-x:hidden;
    /* ★ 关掉 Chromium scroll-anchoring：勾 checkbox / focus 变化 / 异步图片加载
       会让浏览器自动调 scrollTop 试图保持"锚点元素"稳定，但题卡列表异构
       + 图片陆续加载会导致锚点漂移，表现为"勾题后视角被推到下方+大片黑"。
       关掉后所有滚动只在用户主动操作下发生。 */
    overflow-anchor:none}
  .col-l{background:var(--panel);border-right:1px solid var(--line)}
  .col-m{background:var(--bg);padding:24px 32px}
  .col-r{background:var(--panel);border-left:1px solid var(--line);padding:16px}

  /* ===== 左栏 ===== */
  .filter{position:sticky;top:0;background:var(--panel);padding:12px;
    border-bottom:1px solid var(--line);z-index:5}
  .filter input{width:100%;background:var(--panel2);color:var(--text);
    border:1px solid var(--line);border-radius:6px;padding:7px 10px;font-size:13px;outline:none}
  .filter input:focus{border-color:var(--accent)}
  .chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
  .chip{font-size:11px;padding:3px 9px;border-radius:11px;border:1px solid var(--line);
    background:var(--panel2);color:var(--muted);cursor:pointer;user-select:none}
  .chip.active{background:var(--sel);color:var(--text);border-color:var(--accent)}
  .chip.lv1.active{border-color:var(--lv1);color:var(--lv1)}
  .chip.lv2.active{border-color:var(--lv2);color:var(--lv2)}
  .chip.lv3.active{border-color:var(--lv3);color:var(--lv3)}

  .sec{border-bottom:1px solid var(--line)}
  .sec-head{display:flex;align-items:center;justify-content:space-between;
    padding:10px 14px;cursor:pointer;user-select:none;font-weight:600;font-size:13px}
  .sec-head:hover{background:var(--hover)}
  .sec-head .arrow{color:var(--muted);font-size:11px;transition:transform .15s}
  .sec.collapsed .sec-head .arrow{transform:rotate(-90deg)}
  .sec-head .count{color:var(--muted);font-size:11px;font-weight:400}
  .sec-list{display:block}
  .sec.collapsed .sec-list{display:none}
  .item{display:flex;align-items:center;gap:8px;padding:6px 14px 6px 22px;
    cursor:pointer;font-size:13px;border-left:2px solid transparent}
  .item:hover{background:var(--hover)}
  .item.active{background:var(--sel);border-left-color:var(--accent)}
  .item .code{color:var(--muted);font-size:11px;min-width:30px;font-family:Menlo,Consolas,monospace}
  .item .ttl{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .item .star{color:var(--star);font-size:10px}
  .item.hide{display:none}

  /* level 小色块 */
  .lvdot{display:inline-block;width:6px;height:6px;border-radius:50%;flex-shrink:0}
  .lvdot.l1{background:var(--lv1)}
  .lvdot.l2{background:var(--lv2)}
  .lvdot.l3{background:var(--lv3)}

  /* 题量角标：左栏每条考点右侧显示已挂载真题数 */
  .qbadge{display:inline-flex;align-items:center;justify-content:center;
    min-width:18px;height:16px;padding:0 5px;border-radius:8px;
    background:rgba(124,196,255,.14);color:var(--accent);
    font-size:10px;font-weight:600;font-family:Menlo,Consolas,monospace;
    flex-shrink:0;margin-left:4px;letter-spacing:0}
  .qbadge.has-real{background:rgba(95,210,138,.16);color:var(--lv1)}
  .item.active .qbadge{background:rgba(124,196,255,.28)}
  /* 章节小计：附在 sec-head 的 count 后面 */
  .sec-head .qsum{color:var(--lv1);font-size:11px;font-weight:600;margin-left:6px;
    font-family:Menlo,Consolas,monospace}

  /* ===== 中栏 ===== */
  .empty{color:var(--muted);text-align:center;padding:80px 0;font-size:13px}
  .breadcrumb{font-size:12px;color:var(--muted);margin-bottom:8px}
  .breadcrumb b{color:var(--accent)}
  .title-row{display:flex;align-items:baseline;gap:12px;margin-bottom:18px;
    padding-bottom:14px;border-bottom:1px solid var(--line)}
  .title-row h2{font-size:24px;margin:0;font-weight:700;letter-spacing:-.2px}
  .title-row .code-tag{font-family:Menlo,Consolas,monospace;color:var(--muted);
    font-size:14px;background:var(--panel);padding:2px 8px;border-radius:4px}
  .title-row .stars{color:var(--star);font-size:14px}

  .block{margin-bottom:24px}
  .block h3{font-size:13px;font-weight:600;color:var(--muted);
    text-transform:uppercase;letter-spacing:.5px;margin:0 0 10px;
    padding-left:10px;position:relative}
  .block h3::before{content:'';position:absolute;left:0;top:2px;bottom:2px;
    width:3px;background:var(--brand);border-radius:2px}
  .detail{font-size:15px;line-height:1.85}
  .kw-list{display:flex;flex-wrap:wrap;gap:6px}
  .kw{background:var(--panel);border:1px solid var(--line);
    padding:4px 10px;border-radius:13px;font-size:12px;color:var(--accent)}

  .qslot{background:var(--panel);border:1px dashed var(--line);
    border-radius:8px;padding:24px;text-align:center;color:var(--muted);font-size:13px}
  .qslot .hint{font-size:11px;margin-top:6px;color:var(--muted);opacity:.7}

  /* ===== 考察频率 / 趋势 ===== */
  .freq-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-card);padding:14px 16px;
    box-shadow:var(--shadow-card)}
  .freq-summary{font-size:13px;line-height:1.75;color:var(--text);margin-bottom:10px}
  .freq-summary b{color:var(--accent);font-weight:600}
  .freq-tag{display:inline-block;padding:1px 9px;border-radius:10px;font-size:11px;margin-right:8px;
    background:var(--bg);border:1px solid var(--line);vertical-align:1px;letter-spacing:.5px}
  .freq-tag.hot{color:#ff7b54;border-color:#ff7b5466;background:#ff7b541a}
  .freq-tag.warm{color:#ffc450;border-color:#ffc45066;background:#ffc4501a}
  .freq-tag.mild{color:#7bd3ff;border-color:#7bd3ff66;background:#7bd3ff14}
  .freq-tag.cold{color:var(--muted);border-color:var(--line)}
  .freq-chart{display:flex;align-items:flex-end;gap:2px;height:84px;margin:10px 0 4px;
    padding:0 2px;border-bottom:1px solid var(--line)}
  .freq-bar{flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;
    min-width:0;cursor:default;position:relative;height:100%}
  .freq-bar .freq-cell{width:100%;background:var(--accent);border-radius:2px 2px 0 0;
    transition:opacity .15s,transform .15s;min-height:0}
  .freq-bar:hover .freq-cell{opacity:.65;transform:scaleY(1.04);transform-origin:bottom}
  .freq-bar.zero .freq-cell{background:var(--line);opacity:.45}
  .freq-bar.miss .freq-cell{background:transparent;border-bottom:2px dotted var(--muted)}
  .freq-bar.recent .freq-cell{box-shadow:0 0 0 1px var(--accent) inset}
  .freq-axis{display:flex;gap:2px;font-size:9px;color:var(--muted);padding:2px 2px 0;
    font-family:Menlo,Consolas,monospace}
  .freq-axis span{flex:1;text-align:center;min-width:0;overflow:hidden}
  .freq-axis span.major{color:var(--text);font-weight:600}
  .freq-meta{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:11px;color:var(--muted);
    margin-top:8px;padding-top:8px;border-top:1px dashed var(--line)}
  .freq-meta b{color:var(--text);font-weight:600}
  .freq-empty{padding:18px;text-align:center;color:var(--muted);font-size:13px;
    background:var(--panel);border:1px dashed var(--line);border-radius:8px}

  /* ===== 全局搜索结果视图 ===== */
  .srh-header { 
    display:flex; align-items:center; gap:12px; flex-wrap:wrap;
    padding-bottom:12px; margin-bottom:16px; border-bottom:1px solid var(--line);
  }
  .srh-title { font-size:16px; font-weight:600; }
  .srh-title b { color:var(--accent); }
  .srh-stat  { font-size:12px; color:var(--muted); flex:1; }
  .srh-cost  { margin-left:8px; opacity:0.6; font-family:Menlo,Consolas,monospace; font-size:11px; }
  .srh-back  {
    background:transparent; border:1px solid var(--line); color:var(--muted);
    padding:4px 10px; border-radius:4px; font-size:12px; cursor:pointer;
  }
  .srh-back:hover { background:var(--panel); color:#fff; border-color:var(--accent); }

  .srh-section { margin-bottom:24px; }
  .srh-section-title {
    font-size:13px; font-weight:600; color:var(--muted);
    text-transform:uppercase; letter-spacing:.5px; margin:0 0 10px;
    padding-bottom:6px; border-bottom:1px solid var(--line);
  }
  .srh-section-title .srh-count {
    font-weight:400; color:var(--muted); margin-left:6px;
    font-family:Menlo,Consolas,monospace; font-size:11px; opacity:0.8;
  }
  .srh-empty {
    color:var(--muted); padding:14px; text-align:center; font-size:12px;
    background:var(--panel); border-radius:6px;
  }
  .srh-empty .srh-reset-link {
    color:var(--accent); text-decoration:underline; cursor:pointer;
  }

  /* 题目筛选条 */
  .srh-qfilter {
    background:var(--panel); border:1px solid var(--line); border-radius:6px;
    padding:8px 10px; margin:0 0 12px; display:flex; flex-direction:column; gap:6px;
  }
  .srh-qfilter-row {
    display:flex; align-items:center; gap:8px; flex-wrap:wrap;
  }
  .srh-qfilter-label {
    font-size:11px; color:var(--muted); font-weight:600;
    text-transform:uppercase; letter-spacing:.5px;
  }
  .srh-fchip {
    background:transparent; border:1px solid var(--line); color:var(--muted);
    padding:3px 9px; border-radius:12px; font-size:12px; cursor:pointer;
    display:inline-flex; align-items:center; gap:5px;
    transition: all 0.12s;
  }
  .srh-fchip:hover:not(:disabled) {
    border-color:var(--accent); color:#fff;
  }
  .srh-fchip.active {
    background:var(--accent); border-color:var(--accent); color:#fff;
  }
  .srh-fchip.dim {
    opacity:0.4; cursor:not-allowed;
  }
  .srh-fchip-n {
    font-family:Menlo,Consolas,monospace; font-size:10px; opacity:0.75;
    background:rgba(255,255,255,0.08); padding:0 5px; border-radius:8px; min-width:14px;
    text-align:center;
  }
  .srh-fchip.active .srh-fchip-n { background:rgba(255,255,255,0.22); opacity:1; }
  .srh-qfilter-year {
    width:60px; padding:3px 6px; background:var(--bg, #1a1a1a); color:#fff;
    border:1px solid var(--line); border-radius:4px; font-size:12px;
    font-family:Menlo,Consolas,monospace;
  }
  .srh-qfilter-year:focus { outline:none; border-color:var(--accent); }
  .srh-qfilter-year::-webkit-inner-spin-button,
  .srh-qfilter-year::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
  .srh-qfilter-dash { color:var(--muted); font-size:12px; }
  .srh-qfilter-sort, .srh-qfilter-limit {
    padding:3px 6px; background:var(--bg, #1a1a1a); color:#fff;
    border:1px solid var(--line); border-radius:4px; font-size:12px; cursor:pointer;
  }
  .srh-qfilter-sort:focus, .srh-qfilter-limit:focus {
    outline:none; border-color:var(--accent);
  }
  .srh-qfilter-reset {
    background:transparent; border:1px solid var(--line); color:var(--muted);
    padding:3px 9px; border-radius:4px; font-size:11px; cursor:pointer;
    margin-left:auto;
  }
  .srh-qfilter-reset:hover { border-color:#e55; color:#fff; }

  /* ===== 组卷购物车 ===== */
  /* 题卡 checkbox（自定义样式，避免浏览器默认蓝） */
  .srh-q-pick {
    display:inline-flex; align-items:center; cursor:pointer;
    padding:2px; margin-right:2px;
    user-select:none;
    /* ★ 必须 relative：否则子 input 的 absolute 会以 body 为锚，
       跑到 viewport 之外的逻辑位置；点 label 时浏览器自动 focus input
       触发 scrollIntoView 把 #colM 推下去 → 黑屏。 */
    position:relative;
  }
  .srh-q-pick input {
    /* 钉死在 label 内部，inset:0 = top/right/bottom/left 全 0 */
    position:absolute; inset:0; opacity:0; pointer-events:none;
    margin:0;
  }
  .srh-q-pick-mark {
    display:inline-block; width:16px; height:16px;
    border:1.5px solid var(--line); border-radius:3px;
    background:var(--bg); position:relative;
    transition: border-color 0.12s, background 0.12s;
  }
  .srh-q-pick:hover .srh-q-pick-mark { border-color:var(--accent); }
  .srh-q-pick input:checked + .srh-q-pick-mark {
    background:var(--accent); border-color:var(--accent);
  }
  .srh-q-pick input:checked + .srh-q-pick-mark::after {
    content:''; position:absolute; left:4px; top:0px;
    width:5px; height:10px; border:solid #fff;
    border-width:0 2px 2px 0; transform:rotate(45deg);
  }
  .srh-q-wrap.in-basket {
    box-shadow: -2px 0 0 var(--accent) inset;
  }

  /* 考纲题卡 checkbox（嵌在 .q-card 左上）—— 复用搜索视图 srh-q-pick 样式但定位绝对 */
  /* 限定到考纲题卡 #qList 范围内，避免影响搜索视图嵌入的 .srh-embed-q */
  #qList .q-card { position:relative; }
  #qList .q-card > .srh-q-pick {
    position:absolute; top:8px; left:8px; z-index:5;
    /* ★ 内层 input 仍需要一个 positioned 父元素（避免黑屏 bug 复现）：
       .srh-q-pick 自身的 position:relative 被这里 absolute 覆盖，
       但 absolute 也算 positioned ancestor，input 的 inset:0 仍以 .srh-q-pick 为锚 */
    /* 只在父 q-card hover 时显示，避免 idle 状态散落一地选框 */
    opacity:0.45; transition: opacity 0.12s;
  }
  #qList .q-card:hover > .srh-q-pick,
  #qList .q-card.in-basket > .srh-q-pick,
  #qList .q-card > .srh-q-pick:focus-within { opacity:1; }
  /* 给 q-head 让出 checkbox 的位置，避免遮 tags */
  #qList .q-card > .q-head { padding-left:32px; }
  #qList .q-card.in-basket {
    border-left-color:var(--brand2);
    box-shadow: var(--shadow-card), -3px 0 0 var(--accent) inset;
  }

  /* 底部固定栏（参与文档流，body flex column 自动定位）
     不用 position:fixed 是因为 fixed + 滚动容器（.col overflow:auto）一起用，
     Chromium GPU 合成层会留旧绘制 buffer，滚动后出现黑色矩形。
     ★ 用 visibility 而非 display 切换可见性：永远占 56px，避免显隐时
       layout 几何变化 → Chromium scroll-anchoring 反向调 scrollTop →
       视角"被下拉"+下方露出 body 背景黑色。 */
  .basket-bar {
    flex-shrink:0;
    height:0;             /* ★ 空篮时 0 高度，不留黑条 */
    background:#15171c;
    border-top:0;         /* ★ 空篮时无边框 */
    padding:0 20px;       /* ★ 空篮时去掉上下 padding */
    display:flex;         /* 永远 flex，不切 display */
    align-items:center;
    gap:12px;
    font-size:13px;
    box-shadow: 0 -4px 16px rgba(0,0,0,0.4);
    visibility:hidden;    /* 0 题时不可见 */
    overflow:hidden;      /* 高度 0 时裁剪内部 */
    transition: height 0.18s ease, padding 0.18s ease;
  }
  .basket-bar.show {
    visibility:visible;
    height:56px;          /* 有题时恢复 56px */
    border-top:1px solid var(--line);  /* 有题时显示分隔线 */
    padding:10px 20px;    /* 有题时恢复 padding */
  }
  .basket-bar-icon { font-size:18px; }
  .basket-bar-count { color:var(--accent); font-weight:600; font-size:15px; }
  .basket-bar-label { color:var(--muted); }
  .basket-bar-spacer { flex:1; }
  .basket-bar-btn {
    background:transparent; color:var(--text);
    border:1px solid var(--line); border-radius:5px;
    padding:6px 14px; cursor:pointer; font-size:13px;
    transition: border-color 0.12s, background 0.12s, color 0.12s;
  }
  .basket-bar-btn:hover { border-color:var(--accent); color:#fff; }
  .basket-bar-btn.danger:hover { border-color:#e55; color:#fff; }
  .basket-bar-btn.primary {
    background:var(--accent); border-color:var(--accent); color:#fff; font-weight:500;
  }
  .basket-bar-btn.primary:hover { background:#5a8eff; border-color:#5a8eff; }
  /* basket-bar 现在用 flex 文档流定位，三栏 layout 自动让出空间，无需手动调高度 */

  /* 搜索视图下：右栏完全没必要展示（meta 是当前考点信息）+ 隐藏右栏空白避免滚动出黑块 */
  body.search-mode #colR { display:none; }
  body.search-mode .layout { grid-template-columns:280px 1fr; }

  /* ===== 组卷篮子 modal ===== */
  #basketModal {
    position:fixed; inset:0; background:rgba(0,0,0,0.7);
    z-index:9999; display:none; align-items:center; justify-content:center;
  }
  #basketModal.visible { display:flex; }
  #basketModal .bm-box {
    background:var(--panel); border:1px solid var(--line); border-radius:10px;
    padding:20px; width:min(760px, 92vw); max-height:86vh;
    display:flex; flex-direction:column; gap:12px;
  }
  #basketModal .bm-head {
    display:flex; align-items:center; gap:10px; flex-shrink:0;
  }
  #basketModal .bm-title { font-size:16px; font-weight:600; }
  #basketModal .bm-count {
    color:var(--accent); font-weight:600;
    background:rgba(124,196,255,0.12); padding:2px 8px; border-radius:10px;
    font-size:13px;
  }
  #basketModal .bm-spacer { flex:1; }
  #basketModal .bm-close {
    background:transparent; border:none; color:var(--muted);
    font-size:22px; cursor:pointer; padding:0 6px; line-height:1;
  }
  #basketModal .bm-close:hover { color:#fff; }
  #basketModal .bm-hint {
    font-size:12px; color:var(--muted); flex-shrink:0;
  }
  #basketModal .bm-list {
    flex:1; overflow-y:auto; min-height:120px;
    background:var(--bg); border:1px solid var(--line); border-radius:6px;
    padding:8px;
  }
  #basketModal .bm-empty {
    color:var(--muted); font-size:13px; text-align:center;
    padding:40px 20px;
  }
  /* 单题行 */
  .bm-item {
    display:flex; align-items:center; gap:10px;
    padding:8px 10px; margin-bottom:6px;
    background:var(--panel2); border:1px solid var(--line); border-radius:5px;
    font-size:13px; user-select:none;
    transition: border-color 0.12s, background 0.12s, opacity 0.12s;
  }
  .bm-item:last-child { margin-bottom:0; }
  .bm-item:hover { border-color:var(--accent); }
  .bm-item.dragging { opacity:0.4; }
  .bm-item.drop-target { border-color:var(--accent); border-top-width:2px; }
  .bm-item-handle {
    color:var(--muted); cursor:grab; padding:0 4px;
    font-size:14px; line-height:1;
  }
  .bm-item-handle:active { cursor:grabbing; }
  .bm-item-idx {
    color:var(--muted); font-size:12px;
    min-width:24px; text-align:right;
  }
  .bm-item-id {
    font-family:Menlo,Consolas,monospace;
    color:var(--accent); font-size:12px; font-weight:600;
    background:rgba(124,196,255,0.10); padding:2px 6px; border-radius:3px;
  }
  .bm-item-tags {
    display:flex; gap:4px; flex-wrap:wrap;
  }
  .bm-item-tag {
    font-size:11px; padding:1px 6px; border-radius:3px;
    color:var(--muted); background:var(--panel);
    border:1px solid var(--line);
  }
  .bm-item-tag.src-real { color:var(--accent2); border-color:rgba(255,184,107,0.3); }
  .bm-item-title {
    flex:1; color:var(--text);
    overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  }
  .bm-item-del {
    background:transparent; border:1px solid var(--line); color:var(--muted);
    border-radius:3px; padding:2px 8px; cursor:pointer; font-size:12px;
    flex-shrink:0;
  }
  .bm-item-del:hover { border-color:#e55; color:#e55; }
  /* 底部操作 */
  #basketModal .bm-foot {
    display:flex; gap:8px; flex-shrink:0;
    justify-content:flex-end; align-items:center; flex-wrap:wrap;
  }
  #basketModal .bm-foot-spacer { flex:1; }
  #basketModal .bm-btn {
    background:transparent; border:1px solid var(--line); color:var(--text);
    border-radius:5px; padding:6px 14px; cursor:pointer; font-size:13px;
  }
  #basketModal .bm-btn:hover { border-color:var(--accent); color:#fff; }
  #basketModal .bm-btn.danger:hover { border-color:#e55; color:#e55; }
  #basketModal .bm-btn.primary {
    background:var(--accent); border-color:var(--accent); color:#fff; font-weight:500;
  }
  #basketModal .bm-btn.primary:hover { background:#5a8eff; border-color:#5a8eff; }

  /* 题目卡片 */
  .srh-q-list { display:flex; flex-direction:column; gap:14px; }
  .srh-q-card {
    background:var(--panel); border:1px solid var(--line); border-left:3px solid var(--brand);
    border-radius:var(--radius-card); padding:10px 12px; cursor:pointer;
    box-shadow:var(--shadow-card);
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.1s;
  }
  .srh-q-card:hover { border-color:var(--brand2); transform:translateX(2px); box-shadow:var(--shadow-card-hover); }
  .srh-q-head { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:4px; }
  .srh-q-id  { font-family:Menlo,Consolas,monospace; color:var(--accent); font-size:12px; font-weight:600; }
  .srh-q-title { font-size:14px; flex:1; }
  .srh-q-tags { display:flex; gap:4px; flex-wrap:wrap; margin-top:4px; }
  .srh-q-score {
    font-family:Menlo,Consolas,monospace; font-size:11px; color:var(--muted);
    background:rgba(106,222,151,0.1); padding:1px 6px; border-radius:3px;
  }
  .srh-q-kps { font-size:12px; color:var(--muted); margin-top:6px; line-height:1.6; }

  /* —— 搜索视图嵌入的真·题目卡 —— */
  .srh-q-wrap { display:flex; flex-direction:column; gap:4px; }
  .srh-q-meta {
    display:flex; align-items:center; gap:8px; flex-wrap:wrap;
    padding:0 2px;
  }
  .srh-q-id-badge {
    font-family:Menlo,Consolas,monospace; color:var(--accent);
    font-size:11px; font-weight:600;
    background:rgba(106,222,151,0.08); padding:2px 6px; border-radius:3px;
  }
  .srh-jump-kp {
    margin-left:auto;
    background:transparent; color:#ffc450;
    border:1px solid rgba(255,196,80,0.5); border-radius:3px;
    padding:2px 8px; font-size:11px; cursor:pointer;
    transition: background 0.12s, border-color 0.12s;
  }
  .srh-jump-kp:hover { background:rgba(255,196,80,0.12); border-color:#ffc450; }
  .srh-embed-q { border-left:3px solid var(--brand); }

  /* 考纲考点卡片 */
  .srh-kp-list { display:flex; flex-direction:column; gap:6px; }
  .srh-kp-card {
    background:var(--panel); border:1px solid var(--line); border-left:3px solid #ffc450;
    border-radius:var(--radius-card); padding:8px 12px; cursor:pointer;
    box-shadow:var(--shadow-card);
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.1s;
  }
  .srh-kp-card:hover { border-color:#ffc450; transform:translateX(2px);
    box-shadow:0 4px 14px rgba(255,196,80,.18), 0 0 0 1px rgba(255,196,80,.25) inset; }
  .srh-kp-head { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
  .srh-kp-code {
    font-family:Menlo,Consolas,monospace; color:#ffc450; font-size:12px; font-weight:600;
    background:rgba(255,196,80,0.1); padding:1px 6px; border-radius:3px;
  }
  .srh-kp-title { font-size:14px; flex:1; }
  .srh-kp-section { font-size:11px; color:var(--muted); }
  .srh-kp-detail { font-size:12px; color:var(--muted); margin-top:4px; line-height:1.5; }

  /* 教材段落卡片 */
  .srh-tb-list { display:flex; flex-direction:column; gap:6px; }
  .srh-tb-card {
    background:var(--panel); border:1px solid var(--line); border-left:3px solid #6cb;
    border-radius:6px; padding:8px 12px;
  }
  .srh-tb-head { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:4px; }
  .srh-tb-book  { font-size:12px; color:#6cb; }
  .srh-tb-kp    { font-size:12px; color:var(--muted); }
  .srh-tb-loc   { font-size:11px; color:var(--muted); margin-bottom:4px; }
  .srh-tb-preview { font-size:12px; color:#bcd; line-height:1.6; margin-bottom:6px; }
  .srh-tb-actions { display:flex; gap:6px; }
  .srh-tb-actions a { font-size:11px; color:var(--accent); text-decoration:none; }
  .srh-tb-actions a:hover { text-decoration:underline; }
  /* 搜索结果中的 mark 高亮 */
  .srh-q-card mark, .srh-kp-card mark, .srh-tb-card mark {
    background:rgba(106,222,151,0.25); color:#fff; padding:0 2px; border-radius:2px;
  }

  /* ===== 右栏 ===== */
  .meta-card{background:var(--panel2);border:1px solid var(--line);
    border-radius:8px;padding:14px;margin-bottom:14px}
  .meta-card h4{margin:0 0 10px;font-size:11px;color:var(--muted);
    text-transform:uppercase;letter-spacing:.5px;font-weight:600}
  .meta-row{display:flex;justify-content:space-between;font-size:13px;padding:4px 0}
  .meta-row .k{color:var(--muted)}
  .meta-row .v{color:var(--text)}
  .lvbadge{padding:2px 8px;border-radius:10px;font-size:11px;font-weight:600}
  .lvbadge.l1{background:rgba(95,210,138,.15);color:var(--lv1)}
  .lvbadge.l2{background:rgba(124,196,255,.15);color:var(--lv2)}
  .lvbadge.l3{background:rgba(255,138,138,.15);color:var(--lv3)}

  .nav-btns{display:flex;gap:8px;margin-top:8px}
  .nav-btns button{flex:1;background:var(--panel2);color:var(--text);
    border:1px solid var(--line);border-radius:6px;padding:8px;cursor:pointer;font-size:12px}
  .nav-btns button:hover:not(:disabled){background:var(--hover);border-color:var(--accent)}
  .nav-btns button:disabled{opacity:.4;cursor:not-allowed}

  /* 滚动条 */
  
  .q-count{font-size:11px;color:var(--muted);font-weight:400;margin-left:6px}
  .q-filter{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:12px;
    padding:10px 12px;background:var(--panel);border:1px solid var(--line);border-radius:6px}
  .q-filter label{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted)}
  .q-filter select{background:var(--panel2);color:var(--text);border:1px solid var(--line);
    border-radius:4px;padding:4px 8px;font-size:12px;outline:none;font-family:inherit}
  .q-filter select:focus{border-color:var(--accent)}
  .q-list{display:flex;flex-direction:column;gap:10px}
  .q-card{background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--brand);
    border-radius:var(--radius-card);
    overflow:hidden;transition:border-color .15s,box-shadow .15s,transform .12s;
    box-shadow:var(--shadow-card)}
  .q-card:hover{border-color:var(--brand2);box-shadow:var(--shadow-card-hover)}
  .q-head{display:flex;align-items:center;gap:10px;padding:10px 12px;cursor:pointer;user-select:none}
  .q-head:hover{background:var(--hover)}
  .q-tags{display:flex;gap:6px;flex-wrap:wrap}
  .q-tag{font-size:10px;padding:2px 7px;border-radius:9px;background:var(--panel2);
    color:var(--muted);border:1px solid var(--line)}
  .q-tag.src-real{color:var(--accent2);border-color:rgba(255,184,107,.4)}
  .q-tag.src-sim{color:var(--accent);border-color:rgba(124,196,255,.4)}
  .q-title{flex:1;font-size:13px;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .q-arrow{color:var(--muted);font-size:11px;transition:transform .15s}
  .q-card.open .q-arrow{transform:rotate(90deg)}
  .q-body{display:none;padding:0 14px 14px;border-top:1px solid var(--line);font-size:13px;line-height:1.7}
  .q-card.open .q-body{display:block}
  .q-body h5{margin:12px 0 6px;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px}
  .q-body .stem,.q-body .ans,.q-body .sol{white-space:pre-wrap}

  .q-toolbar{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}
  .q-toolbar button{background:var(--panel2);color:var(--text);
    border:1px solid var(--line);border-radius:4px;padding:5px 10px;
    font-size:12px;cursor:pointer;font-family:inherit}
  .q-toolbar button:hover:not(:disabled){background:var(--hover);border-color:var(--accent)}
  .q-toolbar button:disabled{opacity:.4;cursor:not-allowed}
  .q-scroll{max-height:65vh;overflow-y:auto;padding-right:4px;
    border:1px solid var(--line);border-radius:6px;background:rgba(0,0,0,.1)}
  .q-scroll .q-list{padding:8px}


  .q-card.q-hide{display:none}
  .q-notice{background:rgba(124,196,255,.08);border:1px solid rgba(124,196,255,.3);
    border-radius:6px;padding:8px 12px;margin-bottom:8px;font-size:12px;color:var(--muted);
    display:flex;align-items:center;justify-content:space-between;gap:10px}
  .q-notice b{color:var(--accent)}
  .q-notice button{background:var(--panel2);color:var(--text);border:1px solid var(--line);
    border-radius:4px;padding:3px 10px;font-size:11px;cursor:pointer;font-family:inherit}
  .q-notice button:hover{background:var(--hover);border-color:var(--accent)}


  .reveal-bar{display:flex;gap:8px;margin-top:14px;flex-wrap:wrap}
  .reveal-btn{background:var(--panel2);color:var(--muted);border:1px solid var(--line);
    border-radius:4px;padding:4px 12px;font-size:12px;cursor:pointer;font-family:inherit}
  .reveal-btn:hover{background:var(--hover);border-color:var(--accent);color:var(--text)}
  .reveal-btn.active{background:var(--sel);color:var(--accent);border-color:var(--accent)}
  .reveal{display:none;margin-top:4px}
  .reveal.open{display:block}


  .q-imgs{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:6px;margin-bottom:10px}
  .img-count{font-size:11px;color:var(--muted);font-weight:400;margin-left:6px}
  .q-thumb{width:100%;border:1px solid var(--line);border-radius:4px;cursor:zoom-in;
    background:#fff;transition:border-color .12s}
  .q-thumb:hover{border-color:var(--accent)}
  .kp{color:var(--accent2);font-size:13px;background:rgba(255,184,107,.06);
    border-left:2px solid var(--accent2);padding:6px 10px;margin-bottom:8px}
  .lightbox{position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:9999;
    display:none;align-items:center;justify-content:center;cursor:zoom-out}
  .lightbox.open{display:flex}
  .lightbox img{max-width:96vw;max-height:96vh;background:#fff;border-radius:6px;box-shadow:0 4px 30px #000}
  .lightbox .lb-close{position:fixed;top:16px;right:20px;color:#fff;font-size:28px;
    background:none;border:none;cursor:pointer}

  .q-empty{color:var(--muted);text-align:center;padding:20px;font-size:12px;
    border:1px dashed var(--line);border-radius:6px}

  ::-webkit-scrollbar{width:8px;height:8px}
  ::-webkit-scrollbar-thumb{background:#2a3041;border-radius:4px}
  ::-webkit-scrollbar-thumb:hover{background:#3a4258}
  ::-webkit-scrollbar-track{background:transparent}

  /* 响应式 */
  @media(max-width:960px){
    .layout{grid-template-columns:240px 1fr}
    .col-r{display:none}
  }
  @media(max-width:640px){
    .layout{grid-template-columns:1fr}
    .col-l{display:none}
    .col-l.open{display:block;position:fixed;top:48px;left:0;width:280px;
      height:calc(100vh - 48px);z-index:10}
  }
  .menu-btn{display:none;background:none;border:1px solid var(--line);
    color:var(--text);border-radius:4px;padding:4px 10px;cursor:pointer}
  @media(max-width:640px){.menu-btn{display:inline-block}}

  .kp { line-height: 1.95; }
  .kp-chip {
    display: inline-block;
    padding: 2px 8px;
    margin: 2px 4px 2px 0;
    border-radius: 12px;
    background: rgba(124,196,255,0.10);
    border: 1px solid rgba(124,196,255,0.35);
    color: var(--text);
    font-size: 0.88em;
    cursor: default;
  }
  .kp-chip.has-match {
    background: rgba(106,222,151,0.12);
    border-color: rgba(106,222,151,0.45);
    color: #a8e6c2;
    cursor: help;
  }
  .kp-chip.has-match::after {
    content: "📘";
    margin-left: 4px;
    font-size: 0.85em;
    opacity: 0.85;
  }
  .kp-chip.has-match:hover {
    background: rgba(106,222,151,0.20);
    border-color: rgba(106,222,151,0.7);
  }
  /* portal tooltip — 全局 fixed，不受任何祖先 overflow 影响 */
  #kpTooltip {
    position: fixed;
    z-index: 99999;
    display: none;
    background: var(--panel);
    border: 1px solid rgba(106,222,151,0.5);
    border-radius: 8px;
    padding: 10px 12px;
    box-shadow: 0 8px 28px rgba(0,0,0,0.55);
    width: 480px;
    max-width: 92vw;
    max-height: 78vh;
    overflow-y: auto;
    text-align: left;
    font-size: 13px;
    color: var(--text);
    line-height: 1.55;
  }
  #kpTooltip .kpt-book-section + .kpt-book-section {
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px solid var(--line);
  }
  #kpTooltip.visible { display: block; }
  #kpTooltip .kpt-title {
    font-weight: bold;
    color: #a8e6c2;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 5px;
    font-size: 13px;
  }
  #kpTooltip .kpt-match {
    padding: 8px 0;
    border-top: 1px dashed var(--line);
  }
  #kpTooltip .kpt-match:first-of-type { border-top: none; padding-top: 4px; }
  #kpTooltip .kpt-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 3px;
    gap: 8px;
  }
  #kpTooltip .kpt-ref {
    color: #a8e6c2;
    font-weight: 500;
    font-size: 12.5px;
  }
  #kpTooltip .kpt-score {
    color: var(--muted);
    font-size: 11.5px;
    white-space: nowrap;
  }
  /* ===== 相关性分档 (新增) ===== */
  #kpTooltip .kpt-tier {
    display: inline-block;
    font-size: 10.5px;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: 8px;
    margin-left: 6px;
    letter-spacing: 0.3px;
  }
  #kpTooltip .kpt-tier.high { background: rgba(106,222,151,0.18); color: #6ade97; }
  #kpTooltip .kpt-tier.mid  { background: rgba(255,196,80,0.18);  color: #ffc450; }
  #kpTooltip .kpt-tier.low  { background: rgba(160,160,160,0.18); color: #a0a0a0; }
  #kpTooltip .kpt-match.tier-low {
    opacity: 0.55;
  }
  #kpTooltip .kpt-match.tier-low:hover { opacity: 1; }

  /* ===== 弱相关折叠条 ===== */
  #kpTooltip .kpt-weak-wrap {
    margin-top: 6px;
    border-top: 1px dashed rgba(255,255,255,0.08);
    padding-top: 4px;
  }
  #kpTooltip .kpt-weak-wrap > .kpt-weak-summary {
    cursor: pointer;
    color: #9aa;
    font-size: 12px;
    padding: 4px 6px;
    border-radius: 4px;
    user-select: none;
    list-style: none;
    display: flex;
